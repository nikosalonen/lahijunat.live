---
import RouteLinks from "../components/RouteLinks";
import StationManager from "../components/StationManager";
import Layout from "../layouts/Layout.astro";
import {
	getRouteStats,
	getStationStats,
	isServedRoute,
} from "../data/routeStats";
import { fetchStations } from "../utils/api";
import { buildRoutePath, resolveShortCode } from "../utils/stationRoute";

export async function getStaticPaths() {
	const stations = await fetchStations();
	const paths = [];

	// Add the default path (no stations selected)
	paths.push({ params: { stations: undefined } });

	// Generate all possible station combinations. Paths are lowercase because
	// that is the form the site is served from (see utils/stationRoute.ts).
	for (const fromStation of stations) {
		// Add single station paths
		paths.push({
			params: { stations: fromStation.shortCode.toLowerCase() },
		});

		// Add station pairs
		for (const toStation of stations) {
			if (fromStation.shortCode !== toStation.shortCode) {
				paths.push({
					params: {
						stations:
							`${fromStation.shortCode}/${toStation.shortCode}`.toLowerCase(),
					},
				});
			}
		}
	}

	return paths;
}

const stations = await fetchStations();
const { stations: params } = Astro.params;

// Split the URL path into from and to station codes
const [fromStation, toStation] = params?.split("/") || [null, null];

// Resolve the URL codes to canonical (uppercase) short codes; unknown
// stations resolve to null.
const validFromStation = resolveShortCode(stations, fromStation);
const validToStation = resolveShortCode(stations, toStation);

// Get station names for SEO
const getStationName = (code: string | null) => {
	if (!code) return null;
	const station = stations.find((s) => s.shortCode === code);
	return station?.name || null;
};

const fromStationName = getStationName(validFromStation);
const toStationName = getStationName(validToStation);

// Generate dynamic title based on selected stations
const generateTitle = () => {
	if (fromStationName && toStationName) {
		return `Lähijunat ${fromStationName} → ${toStationName} – aikataulut`;
	}
	if (fromStationName) {
		return `Lähijunat ${fromStationName} – aikataulut ja lähtöajat`;
	}
	return "Lähijunien aikataulut reaaliaikaisesti | Lähijunat Live";
};

// Generate dynamic description based on selected stations
// Descriptions carry each page's own numbers, so no two are alike
const generateDescription = () => {
	if (fromStationName && toStationName) {
		const facts = routeStats
			? ` Matka kestää noin ${routeStats.medianDuration} min.`
			: "";
		return `Lähijunat ${fromStationName} → ${toStationName} reaaliaikaisesti: lähtöajat, raiteet ja viiveet.${facts}`;
	}
	if (fromStationName) {
		const facts = stationStats
			? ` Suoria yhteyksiä ${stationStats.destinations} asemalle.`
			: "";
		return `Lähijunien aikataulut asemalta ${fromStationName} reaaliaikaisesti: lähtöajat, raiteet ja viiveet.${facts}`;
	}
	return "Reaaliaikaiset lähtöajat Suomen lähijunille. Saat ajantasaista tietoa lähijunien aikatauluista ja laitureista.";
};

// Generate breadcrumbs for structured data
const generateBreadcrumbs = () => {
	const siteUrl = Astro.site?.toString() || "https://www.lahijunat.live";
	const breadcrumbs = [
		{ name: "Etusivu", url: siteUrl }
	];

	if (fromStationName && validFromStation) {
		breadcrumbs.push({
			name: fromStationName,
			url: new URL(buildRoutePath(validFromStation, null), siteUrl).toString()
		});
	}

	if (toStationName && validFromStation && validToStation) {
		breadcrumbs.push({
			name: toStationName,
			url: new URL(
				buildRoutePath(validFromStation, validToStation),
				siteUrl
			).toString()
		});
	}

	return breadcrumbs;
};

// Feeds the meta description's numbers and the line chips below the live
// trains. The body itself shows no figures.
const routeStats = getRouteStats(validFromStation, validToStation, stations);
const stationStats = validToStation
	? null
	: getStationStats(validFromStation, stations);

// A pair with no direct train has nothing on the page but an empty state.
// Keep following the links so the footer still passes authority on.
const robots =
	validFromStation && validToStation && !isServedRoute(validFromStation, validToStation)
		? "noindex, follow"
		: "index, follow";

// The lines a reader can actually board here: a pair's own lines, or every
// line calling at a single station.
const servingLines = routeStats?.lines ?? stationStats?.lines ?? [];

const findStation = (shortCode: string | null) =>
	shortCode
		? stations.find((station) => station.shortCode === shortCode)
		: undefined;

// Where the reader has to get to in order to catch the train, so a route page
// points at its departure station rather than its destination.
const originStation = findStation(validFromStation);
const destinationStation = findStation(validToStation);

// Only offer the journey back when a direct train runs it, so the link
// points at a route with real departures. isServedRoute covers a full week
// (see its own note), so a weekend-only reverse can still be quiet midweek.
// The two stations travel as objects because RouteLinks localises their
// names, and shipping the whole list to do that cost ~18 kB a page.
const reverseRoute =
	originStation &&
	destinationStation &&
	validFromStation &&
	validToStation &&
	isServedRoute(validToStation, validFromStation)
		? {
				href: buildRoutePath(validToStation, validFromStation),
				from: destinationStation,
				to: originStation,
			}
		: undefined;

const pageTitle = generateTitle();
const pageDescription = generateDescription();
const breadcrumbs = generateBreadcrumbs();
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs} stations={stations} robots={robots} apiPreconnect="always">
	<div class="py-4 sm:py-8">
		<StationManager
			client:load
			stations={stations}
			initialFromStation={validFromStation}
			initialToStation={validToStation}
		/>
		{(servingLines.length > 0 || reverseRoute || originStation) && (
			<RouteLinks
				client:idle
				lines={servingLines}
				reverse={reverseRoute}
				origin={originStation}
			/>
		)}
	</div>
</Layout>

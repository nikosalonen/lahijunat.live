---
import NotFoundPage from "../components/NotFoundPage";
import Layout from "../layouts/Layout.astro";
import { fetchStations } from "../utils/api";

// Netlify serves this file for any unknown URL with a 404 status.
const stations = await fetchStations();
---

<Layout
	title="Sivua ei löytynyt | Lähijunat Live"
	description="Hakemaasi sivua ei löytynyt. Siirry etusivulle tai valitse asema tai linja."
	robots="noindex, follow"
	stations={stations}
>
	<div class="py-12 sm:py-20">
		<div class="w-full max-w-3xl mx-auto px-4 sm:px-6 md:px-8 lg:px-12">
			<NotFoundPage client:load />
		</div>
	</div>
</Layout>

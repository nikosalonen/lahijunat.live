---
import PageHeading from "../../components/PageHeading";
import StationLinks from "../../components/StationLinks";
import { getLines, getLineStats } from "../../data/routeStats";
import Layout from "../../layouts/Layout.astro";
import { fetchStations } from "../../utils/api";

export async function getStaticPaths() {
	// Lowercase, like every other path on the site
	const stations = await fetchStations();
	return getLines(stations).map(({ line }) => ({
		params: { line: line.toLowerCase() },
	}));
}

const stations = await fetchStations();
const { line: lineParam } = Astro.params;
const line = (lineParam ?? "").toUpperCase();
const stats = getLineStats(line, stations);

if (!stats) {
	return Astro.redirect("/linjat/");
}
const stationName = (shortCode: string) =>
	stations.find((station) => station.shortCode === shortCode)?.name ?? shortCode;

// Finnish names for the meta description; the heading localises its own copy
const route = [
	stationName(stats.endpoints[0]),
	...(stats.via ? [stationName(stats.via)] : []),
	stationName(stats.endpoints[1]),
].join(" – ");

const siteUrl = Astro.site?.toString() || "https://www.lahijunat.live";
const breadcrumbs = [
	{ name: "Etusivu", url: siteUrl },
	{ name: "Linjat", url: new URL("/linjat/", siteUrl).toString() },
	{
		name: `${line}-juna`,
		url: new URL(`/linja/${line.toLowerCase()}/`, siteUrl).toString(),
	},
];
---

<Layout
	title={`${line}-juna – aikataulu ja asemat | Lähijunat Live`}
	description={`${line}-juna ${route}: asemat ja reaaliaikaiset lähtöajat. Junia noin ${stats.trainsPerDay} vuorokaudessa, ensimmäinen ${stats.firstDeparture} ja viimeinen ${stats.lastDeparture}.`}
	breadcrumbs={breadcrumbs}
	stations={stations}
>
	<div class="py-4 sm:py-8">
		<div class="w-full max-w-3xl mx-auto px-2 sm:px-6 md:px-8 lg:px-12">
			<PageHeading
				client:load
				titleKey="lineHeading"
				titleValues={{ line }}
				subtitleCodes={[
					stats.endpoints[0],
					...(stats.via ? [stats.via] : []),
					stats.endpoints[1],
				]}
				stations={stations}
				introKey="lineIntro"
				introValues={{
					count: stats.trainsPerDay,
					first: stats.firstDeparture,
					last: stats.lastDeparture,
				}}
			/>
			<StationLinks
				client:visible
				stations={stations}
				codes={stats.stations}
				titleKey="allStations"
				variant="sequence"
				showHeading={false}
			/>
		</div>
	</div>
</Layout>

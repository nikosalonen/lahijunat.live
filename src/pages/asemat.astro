---
import PageHeading from "../components/PageHeading";
import StationLinks from "../components/StationLinks";
import Layout from "../layouts/Layout.astro";
import { fetchStations } from "../utils/api";

const stations = await fetchStations();
const codes = stations.map((station) => station.shortCode);

const siteUrl = Astro.site?.toString() || "https://www.lahijunat.live";
const breadcrumbs = [
	{ name: "Etusivu", url: siteUrl },
	{ name: "Kaikki asemat", url: new URL("/asemat/", siteUrl).toString() },
];
---

<Layout
	title="Kaikki asemat – lähijunien aikataulut | Lähijunat Live"
	description={`Lähijunien aikataulut kaikilta ${codes.length} lähijuna-asemalta: lähtöajat, raiteet ja viiveet reaaliaikaisesti.`}
	breadcrumbs={breadcrumbs}
	stations={stations}
>
	<div class="py-4 sm:py-8">
		<div class="w-full max-w-3xl mx-auto px-2 sm:px-6 md:px-8 lg:px-12">
			<PageHeading
				client:load
				titleKey="allStations"
				introKey="allStationsIntro"
			/>
			<StationLinks
				client:visible
				stations={stations}
				codes={codes}
				titleKey="allStations"
				variant="page"
				sortByName
				showHeading={false}
			/>
		</div>
	</div>
</Layout>

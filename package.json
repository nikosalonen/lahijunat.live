{
	"name": "lahijunat-live",
	"type": "module",
	"version": "1.21.0",
	"packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build && node scripts/stampSwVersion.mjs && workbox generateSW workbox-config.cjs",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "biome check --write src netlify",
		"lint:check": "biome check src netlify",
		"format": "biome format --write src",
		"typecheck": "astro check",
		"check-stations": "pnpm tsx scripts/findStationsWithoutDestinations.ts",
		"update-station-query": "pnpm tsx scripts/updateStationQuery.ts",
		"update-stations-snapshot": "pnpm tsx scripts/updateStationsSnapshot.ts",
		"update-station-info": "pnpm tsx scripts/updateStationInfo.ts && biome check --write src/data/station-info.json",
		"update-route-stats": "pnpm tsx scripts/updateRouteStats.ts && biome check --write src/data/route-stats.json",
		"test-station-query": "pnpm tsx scripts/updateStationQuery.ts --dry-run",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css}": [
			"biome check --write"
		]
	},
	"dependencies": {
		"@astrojs/preact": "^6.1.4",
		"@astrojs/sitemap": "^3.7.4",
		"@netlify/blobs": "^11.1.9",
		"@netlify/functions": "^6.1.1",
		"@tailwindcss/vite": "^4.3.5",
		"astro": "^7.4.10",
		"preact": "^11.2.0",
		"qrcode-generator": "^2.0.4",
		"tailwindcss": "^4.3.5",
		"web-push": "^4.0.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@biomejs/biome": "^2.6.8",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/preact": "^3.2.6",
		"@types/node": "^24.19.2",
		"@types/web-push": "^3.6.4",
		"daisyui": "^5.7.50",
		"husky": "^9.1.7",
		"jsdom": "^31.0.0",
		"lint-staged": "^17.6.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vitest": "^5.1.0",
		"workbox-cli": "^7.4.1"
	}
}

{
	"name": "lahijunat-live",
	"type": "module",
	"version": "1.20.0",
	"packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build && node scripts/stampSwVersion.mjs && workbox generateSW workbox-config.cjs",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "biome check --write src",
		"lint:check": "biome check src",
		"format": "biome format --write src",
		"typecheck": "astro check",
		"check-stations": "pnpm tsx scripts/findStationsWithoutDestinations.ts",
		"update-station-query": "pnpm tsx scripts/updateStationQuery.ts",
		"update-stations-snapshot": "pnpm tsx scripts/updateStationsSnapshot.ts",
		"update-route-stats": "pnpm tsx scripts/updateRouteStats.ts && biome check --write src/data/route-stats.json",
		"test-station-query": "pnpm tsx scripts/updateStationQuery.ts --dry-run",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css}": [
			"biome check --write"
		]
	},
	"dependencies": {
		"@astrojs/preact": "^6.1.1",
		"@astrojs/sitemap": "^3.7.4",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.4.2",
		"preact": "^11.0.2",
		"qrcode-generator": "^2.0.4",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@biomejs/biome": "^2.6.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/preact": "^3.2.6",
		"@types/node": "^24.19.2",
		"daisyui": "^5.7.50",
		"husky": "^9.1.7",
		"jsdom": "^30.1.3",
		"lint-staged": "^17.6.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5",
		"workbox-cli": "^7.4.1"
	}
}

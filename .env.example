# VAPID public key. The browser and the functions both read it. Make one with: pnpm dlx web-push generate-vapid-keys
PUBLIC_VAPID_PUBLIC_KEY=
# VAPID private key. Only the functions read it. Keep it secret.
VAPID_PRIVATE_KEY=
# Set to "false" to turn push alerts off. Any other value keeps them on.
PUBLIC_PUSH_ALERTS_ENABLED=true
